{
  "devDependencies": {
    "@playwright/test": "1.65.1"
  },
  "name": "island-mystery",
  "version": "0.8.0",
  "private": true,
  "description": "Korean social deduction survival game with offline and authoritative online multiplayer",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node tests/serve.cjs",
    "test": "node --test tests/state.test.cjs tests/social.test.cjs tests/phase3.test.cjs tests/phase4.test.cjs tests/phase5.test.cjs tests/phase6.test.cjs tests/phase8.test.cjs",
    "test:simulation": "node tests/simulate-phase8.cjs",
    "test:browser": "node tests/browser-phase6.cjs",
    "test:browser:features": "node tests/browser-phase6-features.cjs",
    "assets:audio": "node scripts/generate-audio.cjs",
    "test:browser:scenes": "node tests/browser-phase5-scenes.cjs",
    "test:strategies": "node tests/strategies-phase6.cjs",
    "start": "node server/index.cjs",
    "test:online": "node --test tests/online.test.cjs tests/profiles-online.test.cjs",
    "test:browser:online": "node tests/browser-phase7.cjs",
    "test:browser:online-features": "node tests/browser-phase7-features.cjs",
    "test:browser:offline-regression": "node tests/browser-phase7-offline.cjs",
    "test:simulation:phase6": "node tests/simulate-phase6.cjs after 300",
    "test:browser:phase8": "node tests/browser-phase8.cjs",
    "test:browser:phase8-online": "node tests/browser-phase8-online.cjs"
  },
  "dependencies": {
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  }
}
