{
  "devDependencies": {
    "@playwright/test": "1.65.1"
  },
  "name": "island-mystery",
  "version": "0.6.0",
  "private": true,
  "description": "Offline Korean social deduction and mystery survival game",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node tests/serve.cjs",
    "test": "node --test tests/state.test.cjs tests/social.test.cjs tests/phase3.test.cjs tests/phase4.test.cjs tests/phase5.test.cjs tests/phase6.test.cjs",
    "test:simulation": "node tests/simulate-phase6.cjs after 300",
    "test:browser": "node tests/browser-phase6.cjs",
    "test:browser:features": "node tests/browser-phase6-features.cjs",
    "assets:audio": "node scripts/generate-audio.cjs",
    "test:browser:scenes": "node tests/browser-phase5-scenes.cjs",
    "test:strategies": "node tests/strategies-phase6.cjs"
  }
}
