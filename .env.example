# Development defaults: node --env-file=.env server/index.cjs
HOST=127.0.0.1
PORT=4174
NODE_ENV=development
# For trusted LAN access only, set HOST=0.0.0.0 and configure the OS firewall.
# Production requires HTTPS behind a WebSocket-capable reverse proxy.
# APP_ORIGIN=https://your-configured-host
# APP_DOMAIN=your-configured-host
ACTION_TIMEOUT_MS=60000
EVENT_TIMEOUT_MS=30000
RESULT_DELAY_MS=2500
ROOM_IDLE_MS=600000
# Waiting-lobby seats expire after 2 minutes disconnected. Active-game seats remain.
LOBBY_RECONNECT_MS=120000
MAX_ROOMS=100

# Persistent guest progression. Keep the database outside public assets.
# PROFILE_DB=E:/path/to/private/profiles.sqlite
PROFILE_DATASET=local
# Test servers must use a separate database and PROFILE_DATASET=test.

# Local beta: use start-beta.cmd; it isolates the port and DB without reading .env.
# APP_ENV=development
# APP_ENV=beta defaults to loopback:4178, data/beta/profiles.sqlite, dataset beta.
